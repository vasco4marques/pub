# Copy to `.env` in this directory (`pub/`) or in `browser-app/` (both are loaded).
# Never commit `.env` — it is gitignored.

# -----------------------------------------------------------------------------
# PostgreSQL — required for workspace file sync / restore
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/itlingo

# Set to PROD for hosted deployments (enables TLS for Postgres with rejectUnauthorized: false).
# Leave unset or use another value for local development.
# ITOI_PROD=

# -----------------------------------------------------------------------------
# ITLingo Cloud API — token file list / downloads (backend HTTP client)
# -----------------------------------------------------------------------------
# Base URL including trailing slash (or omit trailing slash — it will be normalized).
ITLINGO_CLOUD_URL=http://localhost:8000/

# -----------------------------------------------------------------------------
# Workspace filesystem (Docker-style defaults; adjust for local installs)
# -----------------------------------------------------------------------------
# Root where per-session workspace folders are created (must exist or be creatable).
ITOI_HOST_FS=/tmp/theia/workspaces/

# Application root containing `templates/RSL/` and `templates/ASL/` for “Setup project”.
ITOI_HOST_ROOT=/home/theia/pub/

# -----------------------------------------------------------------------------
# Encrypted workspace handoff (/createTempWorkspace?iv=&t=)
# AES-256-CBC key (32 bytes) — MUST be changed in production; keep secret.
# -----------------------------------------------------------------------------
ITOI_WORKSPACE_TOKEN_KEY=v8y/B?E(H+MbQeThWmZq4t7w!z$C&F)J

# -----------------------------------------------------------------------------
# Optional: Node environment (affects defaults in some setups)
# -----------------------------------------------------------------------------
# NODE_ENV=development
